// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  EMPLOYEE
  MASY_OPS
  CLIENT
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  OFFBOARDED
}

enum LeaveType {
  ANNUAL
  SICK
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  DENIED
}

enum ReviewStatus {
  SUBMITTED
  MASY_REVIEWED
  RELEASED
}

enum ConcernVisibility {
  RAW
  MASY_REVIEWED
  CLIENT_VISIBLE
}

enum RoleStage {
  SOURCING
  INTERVIEWING
  OFFER
  FILLED
}

enum CandidateStage {
  APPLIED
  SCREENING
  INTERVIEWING
  OFFER
  HIRED
  REJECTED
}

enum CandidateSource {
  WEBSITE
  MASY_SOURCED
}

enum QuestionType {
  SHORT_TEXT
  LONG_TEXT
  LINK
  MULTIPLE_CHOICE
  CHECKBOXES
}

enum DocumentRequestType {
  EMPLOYMENT_VERIFICATION
  REFERENCE
  SALARY_CONFIRMATION
  OTHER
}

enum DocumentRequestStatus {
  REQUESTED
  IN_PROGRESS
  FULFILLED
  DECLINED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model ClientOrg {
  id                 String              @id @default(cuid())
  name               String
  slug               String              @unique
  status             String              @default("active")
  logoUrl            String?
  employees          Employee[]
  users              User[]
  openRoles          OpenRole[]
  monthlyReportNotes MonthlyReportNote[]
  announcements      Announcement[]
  createdAt          DateTime            @default(now())
}

model User {
  id                String               @id @default(cuid())
  email             String               @unique
  passwordHash      String
  role              Role
  clientOrgId       String?
  clientOrg         ClientOrg?           @relation(fields: [clientOrgId], references: [id])
  employeeId        String?              @unique
  employee          Employee?            @relation(fields: [employeeId], references: [id])
  createdAt         DateTime             @default(now())
  resetTokens       PasswordResetToken[]
  announcementAcks  AnnouncementAck[]
  concernAcks       ConcernAck[]
  performanceReviewAcks PerformanceReviewAck[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Employee {
  id                 String              @id @default(cuid())
  clientOrgId        String
  clientOrg          ClientOrg           @relation(fields: [clientOrgId], references: [id])
  name               String
  roleTitle          String
  status             EmployeeStatus      @default(ACTIVE)
  startDate          DateTime
  dateOfBirth        DateTime?           @db.Date
  email              String
  phone              String?
  staffId            String?
  department         String?
  gender             Gender?
  address            String?
  emergencyContactName  String?
  emergencyContactPhone String?
  photoUrl           String?
  bankAccountNumber  String?
  bankName           String?
  bankAccountHolderName String?
  salary             Decimal?            @db.Decimal(12, 2)
  leaveBalanceDays   Int                 @default(0)
  reviewTemplate     Json?
  user               User?
  attendanceRecords  AttendanceRecord[]
  leaveRequests      LeaveRequest[]
  performanceReviews PerformanceReview[]
  concerns           Concern[]
  pulseCheckIns      PulseCheckIn[]
  onboardingTasks    OnboardingTask[]
  documentRequests   DocumentRequest[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model PulseCheckIn {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  score      Int
  comment    String?
  createdAt  DateTime @default(now())
}

model OnboardingTask {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  label      String
  done       Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model AttendanceRecord {
  id           String    @id @default(cuid())
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id])
  date         DateTime  @db.Date
  clockIn      DateTime
  clockInNote  String?
  clockOut     DateTime?
  clockOutNote String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([employeeId, date])
}

model LeaveRequest {
  id         String      @id @default(cuid())
  employeeId String
  employee   Employee    @relation(fields: [employeeId], references: [id])
  type       LeaveType
  startDate  DateTime    @db.Date
  endDate    DateTime    @db.Date
  reason     String?
  status     LeaveStatus @default(PENDING)
  approverId String?
  decidedAt  DateTime?
  createdAt  DateTime    @default(now())
}

model PerformanceReview {
  id             String       @id @default(cuid())
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id])
  cycle          String
  selfAssessment String
  responses      Json?
  masyNotes      String?
  status         ReviewStatus @default(SUBMITTED)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  acks           PerformanceReviewAck[]
}

model PerformanceReviewAck {
  id               String            @id @default(cuid())
  performanceReviewId String
  performanceReview PerformanceReview @relation(fields: [performanceReviewId], references: [id], onDelete: Cascade)
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  acknowledgedAt   DateTime          @default(now())

  @@unique([performanceReviewId, userId])
}

model Concern {
  id             String            @id @default(cuid())
  employeeId     String
  employee       Employee          @relation(fields: [employeeId], references: [id])
  content        String
  visibility     ConcernVisibility @default(RAW)
  curatedSummary String?
  escalated      Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  acks           ConcernAck[]
}

model ConcernAck {
  id             String   @id @default(cuid())
  concernId      String
  concern        Concern  @relation(fields: [concernId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  acknowledgedAt DateTime @default(now())

  @@unique([concernId, userId])
}

model OpenRole {
  id                      String         @id @default(cuid())
  clientOrgId             String
  clientOrg               ClientOrg      @relation(fields: [clientOrgId], references: [id])
  title                   String
  slug                    String
  description             String?
  location                String?
  shortCode               String?        @unique
  stage                   RoleStage      @default(SOURCING)
  acceptingApplications   Boolean        @default(true)
  askYearsExperience      Boolean        @default(true)
  askExpectedPay          Boolean        @default(true)
  askHowHeard             Boolean        @default(true)
  askResumeLink           Boolean        @default(true)
  askApplicantLocation    Boolean        @default(true)
  questions               RoleQuestion[]
  questionSections        QuestionSection[]
  candidates              Candidate[]
  createdAt               DateTime       @default(now())

  @@unique([clientOrgId, slug])
}

model QuestionSection {
  id         String         @id @default(cuid())
  openRoleId String
  openRole   OpenRole       @relation(fields: [openRoleId], references: [id], onDelete: Cascade)
  title      String
  order      Int            @default(0)
  questions  RoleQuestion[]
  createdAt  DateTime       @default(now())
}

model RoleQuestion {
  id         String            @id @default(cuid())
  openRoleId String
  openRole   OpenRole          @relation(fields: [openRoleId], references: [id], onDelete: Cascade)
  sectionId  String?
  section    QuestionSection?  @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  label      String
  type       QuestionType      @default(SHORT_TEXT)
  options    String[]          @default([])
  required   Boolean           @default(true)
  order      Int               @default(0)
  answers    CandidateAnswer[]
  createdAt  DateTime          @default(now())
}

model Candidate {
  id              String            @id @default(cuid())
  openRoleId      String
  openRole        OpenRole          @relation(fields: [openRoleId], references: [id])
  name            String
  email           String?
  phone           String?
  yearsExperience String?
  location        String?
  resumeLink      String?
  resumeFileName  String?
  resumeFileUrl   String?
  expectedPay     String?
  howHeard        String?
  followedSocials String[]          @default([])
  stage           CandidateStage    @default(APPLIED)
  source          CandidateSource   @default(MASY_SOURCED)
  notes           String?
  answers         CandidateAnswer[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model CandidateAnswer {
  id             String       @id @default(cuid())
  candidateId    String
  candidate      Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  roleQuestionId String
  roleQuestion   RoleQuestion @relation(fields: [roleQuestionId], references: [id], onDelete: Cascade)
  value          String

  @@unique([candidateId, roleQuestionId])
}

model MonthlyReportNote {
  id          String    @id @default(cuid())
  clientOrgId String
  clientOrg   ClientOrg @relation(fields: [clientOrgId], references: [id])
  month       DateTime  @db.Date
  notes       String
  updatedAt   DateTime  @updatedAt

  @@unique([clientOrgId, month])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  targetType String
  targetId   String
  timestamp  DateTime @default(now())
}

model ApplicationAttempt {
  id        String   @id @default(cuid())
  ip        String
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
}

model Announcement {
  id          String            @id @default(cuid())
  clientOrgId String?
  clientOrg   ClientOrg?        @relation(fields: [clientOrgId], references: [id])
  authorRole  Role
  authorLabel String
  title       String
  body        String
  createdAt   DateTime          @default(now())
  acks        AnnouncementAck[]
}

model AnnouncementAck {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  acknowledgedAt DateTime     @default(now())

  @@unique([announcementId, userId])
}

model DocumentRequest {
  id           String                 @id @default(cuid())
  employeeId   String
  employee     Employee               @relation(fields: [employeeId], references: [id])
  type         DocumentRequestType
  details      String?
  status       DocumentRequestStatus  @default(REQUESTED)
  responseNote String?
  requestedAt  DateTime               @default(now())
  fulfilledAt  DateTime?
}
