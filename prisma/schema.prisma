// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  EMPLOYEE
  MASY_OPS
  CLIENT
}

enum EmployeeStatus {
  PENDING
  ACTIVE
  ON_LEAVE
  OFFBOARDED
}

enum LeaveType {
  ANNUAL
  SICK
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  DENIED
}

enum ReviewStatus {
  DRAFT
  SUBMITTED
  MASY_REVIEWED
  RELEASED
}

enum ConcernVisibility {
  RAW
  MASY_REVIEWED
  CLIENT_VISIBLE
}

enum RoleStage {
  SOURCING
  INTERVIEWING
  OFFER
  FILLED
}

enum RecruitmentMode {
  FORMAL
  INFORMAL
}

enum CandidateStage {
  APPLIED
  SCREENING
  INTERVIEWING
  OFFER
  HIRED
  REJECTED
}

enum CandidateSource {
  WEBSITE
  MASY_SOURCED
  GOOGLE_FORM
}

enum QuestionType {
  SHORT_TEXT
  LONG_TEXT
  LINK
  MULTIPLE_CHOICE
  CHECKBOXES
  PHOTO
}

enum DocumentRequestType {
  EMPLOYMENT_VERIFICATION
  REFERENCE
  SALARY_CONFIRMATION
  OTHER
}

enum DocumentRequestStatus {
  REQUESTED
  IN_PROGRESS
  FULFILLED
  DECLINED
}

enum EmployeeDocumentCategory {
  EMPLOYMENT_LETTER
  ONBOARDING
  IDENTIFICATION
  CONTRACT
  PROOF_OF_ADDRESS
  NIN_SLIP
  OTHER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum OnboardingStepType {
  PERSONAL_DETAILS
  IDENTITY_DOCUMENTS
  GUARANTORS
  ACKNOWLEDGMENTS
  SIGNATURE
  PROPERTY_HANDOVER
}

enum OnboardingStepStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  NEEDS_CORRECTION
  VERIFIED
}

enum CountersignerRole {
  FOUNDER_OR_CLIENT_ADMIN
  HR_MASY
}

enum IdDocumentType {
  PASSPORT
  DRIVERS_LICENSE
}

enum BankNameMatchStatus {
  UNVERIFIED
  MATCHED
  NEEDS_REVIEW
}

enum GuarantorVerificationMethod {
  PHONE_CALL
  EMAIL
  OTHER
}

enum GuarantorVerificationResult {
  PENDING
  VERIFIED
  FAILED
}

enum AcknowledgmentDocumentType {
  EMPLOYMENT_AGREEMENT
  HANDBOOK
  PRIVACY_NOTICE
}

enum SignatureDocumentType {
  EMPLOYMENT_AGREEMENT
  HANDBOOK
  PROPERTY_HANDOVER
}

enum AssetStatus {
  PENDING
  ISSUED
  RETURNED
  LOST
  DAMAGED
  IN_REPAIR
}

model ClientOrg {
  id                 String              @id @default(cuid())
  name               String
  slug               String              @unique
  status             String              @default("active")
  logoUrl            String?
  employees          Employee[]
  users              User[]
  openRoles          OpenRole[]
  applicationGroups  ApplicationGroup[]
  monthlyReportNotes MonthlyReportNote[]
  announcements      Announcement[]
  createdAt          DateTime            @default(now())

  // Letterhead + onboarding content, per client -- replaces the old single global
  // CompanySettings template so every client's agreement/contract renders on their own letterhead.
  letterheadLogoUrl           String?
  companyLegalName            String?
  companyAddress              String?
  signatoryName                String?
  signatoryTitle               String?
  contractLetterTemplateText  String?
  contractLetterTemplateName  String?
  employmentAgreementTemplate String?
  employmentAgreementVersion  String?   @default("1.0")
  handbookText                 String?
  handbookVersion               String?   @default("1.0")
  privacyNoticeText            String?
  privacyNoticeVersion          String?   @default("1.0")
  onboardingCountersignerRole CountersignerRole @default(FOUNDER_OR_CLIENT_ADMIN)
  // Set only when someone has explicitly confirmed the drafted agreement/handbook/quiz were
  // reviewed (ideally by a professional). The onboarding flow refuses to start a new hire's
  // Step 4 until this is set, so an unreviewed AI draft can never reach a real employee.
  onboardingContentReviewedAt   DateTime?
  onboardingContentReviewedById String?
  comprehensionQuestions       ComprehensionQuestion[]
}

model User {
  id                String               @id @default(cuid())
  email             String               @unique
  passwordHash      String
  role              Role
  clientOrgId       String?
  clientOrg         ClientOrg?           @relation(fields: [clientOrgId], references: [id])
  employeeId        String?              @unique
  employee          Employee?            @relation(fields: [employeeId], references: [id])
  createdAt         DateTime             @default(now())
  resetTokens       PasswordResetToken[]
  announcementAcks  AnnouncementAck[]
  concernAcks       ConcernAck[]
  performanceReviewAcks PerformanceReviewAck[]
  employeeDocumentAcks EmployeeDocumentAck[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Employee {
  id                 String              @id @default(cuid())
  clientOrgId        String
  clientOrg          ClientOrg           @relation(fields: [clientOrgId], references: [id])
  name               String
  roleTitle          String
  status             EmployeeStatus      @default(ACTIVE)
  startDate          DateTime
  dateOfBirth        DateTime?           @db.Date
  email              String
  phone              String?
  whatsappNumber     String?
  staffId            String?
  department         String?
  gender             Gender?
  address            String?
  emergencyContactName  String?
  emergencyContactPhone String?
  photoUrl           String?
  bankAccountNumber  String?
  bankName           String?
  bankAccountHolderName String?
  bankNameMatchStatus BankNameMatchStatus @default(UNVERIFIED)
  preferredName      String?
  personalEmail      String?
  nin                String?
  shiftLabel         String?
  shiftDescription   String?
  salary             Decimal?            @db.Decimal(12, 2)
  leaveBalanceDays   Int                 @default(0)
  reviewTemplate     Json?
  contractLetterDraft String?
  user               User?
  attendanceRecords  AttendanceRecord[]
  leaveRequests      LeaveRequest[]
  performanceReviews PerformanceReview[]
  concerns           Concern[]
  pulseCheckIns      PulseCheckIn[]
  onboardingTasks    OnboardingTask[]
  onboardingQuestions OnboardingQuestion[]
  documentRequests   DocumentRequest[]
  documents          EmployeeDocument[]
  onboardingInvite   OnboardingInvite?
  sourceCandidate    Candidate?
  onboardingProcess        OnboardingProcess?
  guarantors               Guarantor[]
  documentAcknowledgments  DocumentAcknowledgment[]
  keyTermAcknowledgments   KeyTermAcknowledgment[]
  comprehensionAttempts    ComprehensionAttempt[]
  eSignatures              ESignature[]
  companyAssets            CompanyAsset[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model EmployeeDocument {
  id             String                   @id @default(cuid())
  employeeId     String
  employee       Employee                 @relation(fields: [employeeId], references: [id])
  label          String
  category       EmployeeDocumentCategory @default(OTHER)
  idDocumentType IdDocumentType?
  documentDate   DateTime?                @db.Date
  fileUrl        String
  fileName       String
  uploadedById   String
  createdAt      DateTime                 @default(now())
  acks           EmployeeDocumentAck[]
}

model EmployeeDocumentAck {
  id                 String           @id @default(cuid())
  employeeDocumentId String
  employeeDocument   EmployeeDocument @relation(fields: [employeeDocumentId], references: [id], onDelete: Cascade)
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  acknowledgedAt     DateTime         @default(now())

  @@unique([employeeDocumentId, userId])
}

model OnboardingQuestion {
  id         String       @id @default(cuid())
  employeeId String
  employee   Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  label      String
  type       QuestionType @default(SHORT_TEXT)
  options    String[]     @default([])
  required   Boolean      @default(true)
  order      Int          @default(0)
  answer     String?
  createdAt  DateTime     @default(now())
}

model OnboardingInvite {
  id          String    @id @default(cuid())
  employeeId  String    @unique
  employee    Employee  @relation(fields: [employeeId], references: [id])
  token       String    @unique
  expiresAt   DateTime
  completedAt DateTime?
  createdAt   DateTime  @default(now())
}

model PulseCheckIn {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  score      Int
  comment    String?
  createdAt  DateTime @default(now())
}

model OnboardingTask {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  label      String
  done       Boolean  @default(false)
  createdAt  DateTime @default(now())
}

// Stays the day-summary row everything else (reports, nudges, payroll sheets) already reads:
// clockIn/clockInNote mirror the day's FIRST session, clockOut/clockOutNote mirror the most
// recent one (null clockOut still means "currently clocked in", same as before). The detailed
// in/out/reason history for the day lives in `sessions`.
model AttendanceRecord {
  id           String    @id @default(cuid())
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id])
  date         DateTime  @db.Date
  clockIn      DateTime
  clockInNote  String?
  clockOut     DateTime?
  clockOutNote String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     AttendanceSession[]

  @@unique([employeeId, date])
}

// One row per clock-in/clock-out pair within a day -- lets an employee step away from their
// desk (clock out with a reason) and clock back in later the same day without losing the
// earlier session's time.
model AttendanceSession {
  id                 String           @id @default(cuid())
  attendanceRecordId String
  attendanceRecord   AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  clockIn            DateTime
  clockInNote        String?
  clockOut           DateTime?
  clockOutNote       String?
  createdAt          DateTime         @default(now())
}

model LeaveRequest {
  id         String      @id @default(cuid())
  employeeId String
  employee   Employee    @relation(fields: [employeeId], references: [id])
  type       LeaveType
  startDate  DateTime    @db.Date
  endDate    DateTime    @db.Date
  reason     String?
  status     LeaveStatus @default(PENDING)
  approverId String?
  decidedAt  DateTime?
  createdAt  DateTime    @default(now())
}

model PerformanceReview {
  id             String       @id @default(cuid())
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id])
  cycle          String
  selfAssessment String
  responses      Json?
  masyNotes      String?
  status         ReviewStatus @default(SUBMITTED)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  acks           PerformanceReviewAck[]
}

model PerformanceReviewAck {
  id               String            @id @default(cuid())
  performanceReviewId String
  performanceReview PerformanceReview @relation(fields: [performanceReviewId], references: [id], onDelete: Cascade)
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  acknowledgedAt   DateTime          @default(now())

  @@unique([performanceReviewId, userId])
}

model Concern {
  id             String            @id @default(cuid())
  employeeId     String
  employee       Employee          @relation(fields: [employeeId], references: [id])
  content        String
  visibility     ConcernVisibility @default(RAW)
  curatedSummary String?
  escalated      Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  acks           ConcernAck[]
}

model ConcernAck {
  id             String   @id @default(cuid())
  concernId      String
  concern        Concern  @relation(fields: [concernId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  acknowledgedAt DateTime @default(now())

  @@unique([concernId, userId])
}

model OpenRole {
  id                      String         @id @default(cuid())
  clientOrgId             String
  clientOrg               ClientOrg      @relation(fields: [clientOrgId], references: [id])
  title                   String
  slug                    String
  description             String?
  displayOrder            Int            @default(0)
  location                String?
  shortCode               String?        @unique
  stage                   RoleStage      @default(SOURCING)
  mode                    RecruitmentMode @default(FORMAL)
  workSampleLabel         String?
  googleFormWebhookToken  String?        @unique
  googleFormPublicUrl     String?
  applicationGroupId      String?
  applicationGroup        ApplicationGroup? @relation(fields: [applicationGroupId], references: [id])
  acceptingApplications   Boolean        @default(true)
  askYearsExperience      Boolean        @default(true)
  askExpectedPay          Boolean        @default(true)
  askHowHeard             Boolean        @default(true)
  askResumeLink           Boolean        @default(true)
  askApplicantLocation    Boolean        @default(true)
  schedulingLink          String?
  customInterviewMessage  String?
  customOfferMessage      String?
  questions               RoleQuestion[]
  questionSections        QuestionSection[]
  candidates              Candidate[]
  createdAt               DateTime       @default(now())

  @@unique([clientOrgId, slug])
}

model QuestionSection {
  id         String         @id @default(cuid())
  openRoleId String
  openRole   OpenRole       @relation(fields: [openRoleId], references: [id], onDelete: Cascade)
  title      String
  order      Int            @default(0)
  questions  RoleQuestion[]
  createdAt  DateTime       @default(now())
}

model RoleQuestion {
  id         String            @id @default(cuid())
  openRoleId String
  openRole   OpenRole          @relation(fields: [openRoleId], references: [id], onDelete: Cascade)
  sectionId  String?
  section    QuestionSection?  @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  label      String
  type       QuestionType      @default(SHORT_TEXT)
  options    String[]          @default([])
  required   Boolean           @default(true)
  order      Int               @default(0)
  answers    CandidateAnswer[]
  createdAt  DateTime          @default(now())
}

model Candidate {
  id              String            @id @default(cuid())
  openRoleId      String
  openRole        OpenRole          @relation(fields: [openRoleId], references: [id])
  name            String
  email           String?
  phone           String?
  yearsExperience String?
  location        String?
  resumeLink      String?
  resumeFileName  String?
  resumeFileUrl   String?
  workSampleUrl   String?
  expectedPay     String?
  howHeard        String?
  followedSocials String[]          @default([])
  stage           CandidateStage    @default(APPLIED)
  source          CandidateSource   @default(MASY_SOURCED)
  notes           String?
  rejectionEmailSentAt   DateTime?
  interviewInviteSentAt  DateTime?
  offerEmailSentAt       DateTime?
  convertedEmployeeId String?           @unique
  convertedEmployee   Employee?         @relation(fields: [convertedEmployeeId], references: [id])
  convertedAt         DateTime?
  aiScore         Int?
  aiRationale     String?
  answers         CandidateAnswer[]
  generalAnswers  GeneralAnswer[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model CandidateAnswer {
  id             String       @id @default(cuid())
  candidateId    String
  candidate      Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  roleQuestionId String
  roleQuestion   RoleQuestion @relation(fields: [roleQuestionId], references: [id], onDelete: Cascade)
  value          String

  @@unique([candidateId, roleQuestionId])
}

// A shared apply link for two or more roles at one company: applicants pick which role
// they're applying for, then answer these shared questions plus that role's own questions.
model ApplicationGroup {
  id                     String            @id @default(cuid())
  clientOrgId            String
  clientOrg              ClientOrg         @relation(fields: [clientOrgId], references: [id])
  title                  String
  slug                   String
  googleFormWebhookToken String?           @unique
  googleFormPublicUrl    String?
  roles                  OpenRole[]
  questions              GeneralQuestion[]
  createdAt              DateTime          @default(now())

  @@unique([clientOrgId, slug])
}

model GeneralQuestion {
  id                 String           @id @default(cuid())
  applicationGroupId String
  applicationGroup   ApplicationGroup @relation(fields: [applicationGroupId], references: [id], onDelete: Cascade)
  label              String
  type               QuestionType     @default(SHORT_TEXT)
  options            String[]         @default([])
  required           Boolean          @default(true)
  order              Int              @default(0)
  answers            GeneralAnswer[]
  createdAt          DateTime         @default(now())
}

model GeneralAnswer {
  id                String          @id @default(cuid())
  candidateId       String
  candidate         Candidate       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  generalQuestionId String
  generalQuestion   GeneralQuestion @relation(fields: [generalQuestionId], references: [id], onDelete: Cascade)
  value             String

  @@unique([candidateId, generalQuestionId])
}

model MonthlyReportNote {
  id          String    @id @default(cuid())
  clientOrgId String
  clientOrg   ClientOrg @relation(fields: [clientOrgId], references: [id])
  month       DateTime  @db.Date
  notes       String
  updatedAt   DateTime  @updatedAt

  @@unique([clientOrgId, month])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  targetType String
  targetId   String
  timestamp  DateTime @default(now())
}

model ApplicationAttempt {
  id         String   @id @default(cuid())
  ip         String
  openRoleId String?
  createdAt  DateTime @default(now())

  @@index([ip, openRoleId, createdAt])
}

model Announcement {
  id          String            @id @default(cuid())
  clientOrgId String?
  clientOrg   ClientOrg?        @relation(fields: [clientOrgId], references: [id])
  authorRole  Role
  authorLabel String
  title       String
  body        String
  createdAt   DateTime          @default(now())
  acks        AnnouncementAck[]
}

model AnnouncementAck {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  acknowledgedAt DateTime     @default(now())

  @@unique([announcementId, userId])
}

model DocumentRequest {
  id           String                 @id @default(cuid())
  employeeId   String
  employee     Employee               @relation(fields: [employeeId], references: [id])
  type         DocumentRequestType
  details      String?
  status       DocumentRequestStatus  @default(REQUESTED)
  responseNote String?
  requestedAt  DateTime               @default(now())
  fulfilledAt  DateTime?
}

// One row per employee -- the gate. The normal dashboard stays locked until completedAt is set,
// which only happens once every OnboardingStep below is VERIFIED.
model OnboardingProcess {
  id             String          @id @default(cuid())
  employeeId     String          @unique
  employee       Employee        @relation(fields: [employeeId], references: [id])
  commencementDate DateTime      @db.Date
  // Recorded before Step 1 even opens -- a brief notice + consent, timestamped, ahead of any
  // personal data collection. The full Privacy Notice is still read and acknowledged in detail
  // at Step 4; this is the separate, earlier "before any personal data is collected" gate.
  privacyConsentAt DateTime?
  completedAt    DateTime?
  completedById  String?
  steps          OnboardingStep[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model OnboardingStep {
  id                  String               @id @default(cuid())
  onboardingProcessId String
  onboardingProcess   OnboardingProcess    @relation(fields: [onboardingProcessId], references: [id], onDelete: Cascade)
  stepType            OnboardingStepType
  status              OnboardingStepStatus @default(NOT_STARTED)
  submittedAt         DateTime?
  verifiedAt          DateTime?
  verifiedById        String?
  correctionReason    String?
  correctionRequestedAt DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@unique([onboardingProcessId, stepType])
}

model Guarantor {
  id                 String    @id @default(cuid())
  employeeId         String
  employee           Employee  @relation(fields: [employeeId], references: [id])
  name               String
  relationship       String
  phone              String
  email              String
  occupation         String?
  address            String
  consentConfirmed   Boolean   @default(false)
  replacedAt         DateTime?
  replacementDeadline DateTime?
  createdAt          DateTime  @default(now())
  verificationLogs   GuarantorVerificationLog[]
}

model GuarantorVerificationLog {
  id               String                      @id @default(cuid())
  guarantorId      String
  guarantor        Guarantor                   @relation(fields: [guarantorId], references: [id], onDelete: Cascade)
  verifiedById     String
  method           GuarantorVerificationMethod
  result           GuarantorVerificationResult @default(PENDING)
  followUpNeeded   Boolean                      @default(false)
  notes            String?
  verifiedAt       DateTime                     @default(now())
}

// Scroll-to-end + time-on-page acknowledgment of the agreement/handbook/privacy notice.
// Versioned so a re-issued document (e.g. after a pay change) requires a fresh acknowledgment.
model DocumentAcknowledgment {
  id             String                     @id @default(cuid())
  employeeId     String
  employee       Employee                   @relation(fields: [employeeId], references: [id])
  documentType   AcknowledgmentDocumentType
  version        String
  scrolledToEnd  Boolean                    @default(false)
  timeSpentSeconds Int                      @default(0)
  acknowledgedAt DateTime?
  createdAt      DateTime                   @default(now())

  @@unique([employeeId, documentType, version])
}

// One row per line of the agreement's "Acknowledgment of Key Terms" table, plus the
// Shift B confirmation -- each ticked and timestamped independently so a dispute over
// "it wasn't in the contract" has a specific, dated record to point to.
model KeyTermAcknowledgment {
  id             String    @id @default(cuid())
  employeeId     String
  employee       Employee  @relation(fields: [employeeId], references: [id])
  termKey        String
  acknowledgedAt DateTime  @default(now())

  @@unique([employeeId, termKey])
}

// Per-client question bank for the comprehension check (Step 4). correctChoiceIndex indexes
// into `choices`.
model ComprehensionQuestion {
  id                 String    @id @default(cuid())
  clientOrgId        String
  clientOrg          ClientOrg @relation(fields: [clientOrgId], references: [id])
  question           String
  choices            String[]
  correctChoiceIndex Int
  explanation        String?
  order              Int       @default(0)
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now())
}

model ComprehensionAttempt {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  answers     Json
  score       Int
  passed      Boolean
  attemptedAt DateTime @default(now())
}

// Three signing events per employee: Employment Agreement, Handbook, Property Handover.
// `version` increments if a document is re-issued after NEEDS_CORRECTION, so old signatures
// stay intact instead of being overwritten.
model ESignature {
  id                   String                @id @default(cuid())
  employeeId           String
  employee             Employee              @relation(fields: [employeeId], references: [id])
  documentType         SignatureDocumentType
  version              Int                   @default(1)
  typedName            String
  signatureImageData   String
  ipAddress            String
  userAgent            String?
  documentHash         String
  pdfUrl               String?
  signedAt             DateTime              @default(now())
  countersignedById    String?
  countersignedAt      DateTime?
  countersignIpAddress String?

  @@unique([employeeId, documentType, version])
}

// Company property issued to an employee. `noEquipmentIssued` closes Step 6 for roles that
// need none, with a reason, instead of leaving the step stuck.
model CompanyAsset {
  id              String      @id @default(cuid())
  employeeId      String
  employee        Employee    @relation(fields: [employeeId], references: [id])
  itemType        String
  brand           String?
  model           String?
  serialOrImei    String?
  accessories     String[]    @default([])
  conditionNotes  String?
  conditionPhotoUrls String[] @default([])
  employeeDisagreesNote String?
  employeeDisagreesPhotoUrls String[] @default([])
  status          AssetStatus @default(PENDING)
  issueDate       DateTime?   @db.Date
  returnDeadline  DateTime?
  returnedAt      DateTime?
  verifiedAt             DateTime?
  verifiedById           String?
  managementApprovedAt   DateTime?
  managementApprovedById String?
  createdById     String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}
